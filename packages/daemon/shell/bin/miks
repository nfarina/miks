#!/bin/zsh
# Miks's `miks open`, `miks edit` and `miks browse`, an executable so that
# any program can run it, not just your shell: `miks edit --wait` is $EDITOR
# in Miks tabs (see miks-editor). The rest of `miks` (keep, update) is a
# function in Miks's .zshrc, which hands these here.
#
#   miks open <file>           Shows the file in the tab's panel.
#   miks edit [--wait] <file>  The same, ready to edit; with --wait, returns
#                              once you're done with it (Done, or closing it).
#   miks browse <url>          Shows the page in the tab's panel, loaded from
#                              this Mac: its localhost, wherever the window is.
#   miks version               Which Miks the daemon runs, and on which Mac;
#                              what's installed there (it may need a restart);
#                              and which Miks each window on it is, this one
#                              first.

emulate -L zsh

usage() {
  print -u2 "Usage: miks open <file>"
  print -u2 "       miks edit [--wait] <file>"
  print -u2 "       miks browse <url>"
  print -u2 "       miks version"
  exit 2
}

mode=$1
[[ $mode == (open|edit|browse|version) ]] || usage
shift

if [[ $mode == version ]]; then
  if [[ ! -S $MIKS_SOCKET ]]; then
    print -u2 "miks version: only in a Miks tab."
    exit 1
  fi
  color=0
  [[ -t 1 && -z $NO_COLOR ]] && color=1
  # A daemon from before it answers 404.
  curl -sf -m 5 --unix-socket "$MIKS_SOCKET" "http://miks/api/version?pane=$MIKS_PANE_ID&color=$color" || {
    print -u2 "miks version: this daemon is from a Miks before miks version."
    exit 1
  }
  exit 0
fi

if [[ $mode == browse ]]; then
  (( $# == 1 )) || usage
  if [[ -z $MIKS_PANE_ID || ! -S $MIKS_SOCKET ]]; then
    print -u2 "miks browse: only in a Miks tab."
    exit 1
  fi
  answer=$(print -rn -- "$1" | curl -s -m 5 -w '\n%{http_code}' --unix-socket "$MIKS_SOCKET" --data-binary @- "http://miks/api/browse?pane=$MIKS_PANE_ID")
  if [[ $? -ne 0 ]]; then
    print -u2 "miks browse: Miks didn't answer."
    exit 1
  fi
  if [[ ${answer##*$'\n'} != 200 ]]; then
    print -u2 "miks browse: not a web address: $1"
    exit 1
  fi
  exit 0
fi
wait=0
if [[ $mode == edit && $1 == --wait ]]; then
  wait=1
  shift
fi
(( $# == 1 )) || usage

if [[ -z $MIKS_PANE_ID || ! -S $MIKS_SOCKET ]]; then
  print -u2 "miks $mode: only in a Miks tab."
  exit 1
fi

file=${1:A}
if [[ -d $file ]]; then
  print -u2 "miks $mode: $1 is a folder."
  exit 1
fi
# Editing a file that isn't there yet makes it on saving; just looking at one doesn't.
if [[ $mode == open && ! -e $file ]]; then
  print -u2 "miks open: no such file: $1"
  exit 1
fi

edit=0
[[ $mode == edit ]] && edit=1
query="pane=$MIKS_PANE_ID&edit=$edit&wait=$wait"
# Waiting has no time limit: it's until you're done.
limit=(-m 5)
(( wait )) && limit=()
if ! print -rn -- "$file" | curl -sf $limit --unix-socket "$MIKS_SOCKET" --data-binary @- "http://miks/api/open?$query" >/dev/null; then
  print -u2 "miks $mode: Miks didn't answer."
  exit 1
fi
